<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Admin - Registered Users</title>
    <link rel="stylesheet" href="/css/admin-style.css">
</head>
<body>
    <div class="admin-layout" style="display: flex;">
        <%- include('partials/sidebar') %>

        <main class="main-content" style="flex: 1; padding: 20px; min-width: 0;">
            <h2>Registered Users</h2>
            <p>Profiles submitted from your Flutter app (<%= (typeof profiles !== 'undefined' && profiles) ? profiles.length : 0 %> total).</p>

            <div style="overflow-x: auto;">
            <table class="table" style="width: 100%; border-collapse: collapse; margin-top: 20px; background: #fff; min-width: 1000px;">
                <thead>
                    <tr style="background: #f4f4f4; text-align: left;">
                        <th style="padding: 12px; border: 1px solid #ddd;">ID</th>
                        <th style="padding: 12px; border: 1px solid #ddd;">Photo</th>
                        <th style="padding: 12px; border: 1px solid #ddd;">Email</th>
                        <th style="padding: 12px; border: 1px solid #ddd;">First Name</th>
                        <th style="padding: 12px; border: 1px solid #ddd;">Last Name</th>
                        <th style="padding: 12px; border: 1px solid #ddd;">Gender</th>
                        <th style="padding: 12px; border: 1px solid #ddd;">Birth Date</th>
                        <th style="padding: 12px; border: 1px solid #ddd;">ID Type</th>
                        <th style="padding: 12px; border: 1px solid #ddd;">ID Number</th>
                        <th style="padding: 12px; border: 1px solid #ddd;">ID Expiry</th>
                        <th style="padding: 12px; border: 1px solid #ddd;">Address</th>
                        <th style="padding: 12px; border: 1px solid #ddd;">Registered At</th>
                    </tr>
                </thead>
                <tbody>
                    <% if (typeof profiles !== 'undefined' && profiles && profiles.length > 0) { %>
                        <% profiles.forEach(p => { %>
                            <tr>
                                <td style="padding: 10px; border: 1px solid #ddd;"><%= p.id %></td>
                                <td style="padding: 10px; border: 1px solid #ddd;">
                                    <% if (p.photo_path) { %>
                                        <img src="<%= p.photo_path %>" alt="photo" style="width: 48px; height: 48px; border-radius: 50%; object-fit: cover;">
                                    <% } else { %>
                                        <span style="display: inline-block; width: 48px; height: 48px; border-radius: 50%; background: #d1d5db;"></span>
                                    <% } %>
                                </td>
                                <td style="padding: 10px; border: 1px solid #ddd;"><%= p.email %></td>
                                <td style="padding: 10px; border: 1px solid #ddd;"><%= p.first_name %></td>
                                <td style="padding: 10px; border: 1px solid #ddd;"><%= p.last_name %></td>
                                <td style="padding: 10px; border: 1px solid #ddd;"><%= p.gender || '-' %></td>
                                <td style="padding: 10px; border: 1px solid #ddd;"><%= p.birth_date ? new Date(p.birth_date).toLocaleDateString('en-GB') : '-' %></td>
                                <td style="padding: 10px; border: 1px solid #ddd;"><%= p.id_type || '-' %></td>
                                <td style="padding: 10px; border: 1px solid #ddd;"><%= p.id_number || '-' %></td>
                                <td style="padding: 10px; border: 1px solid #ddd;"><%= p.id_expiry_date ? new Date(p.id_expiry_date).toLocaleDateString('en-GB') : '-' %></td>
                                <td style="padding: 10px; border: 1px solid #ddd;"><%= p.address || '-' %></td>
                                <td style="padding: 10px; border: 1px solid #ddd;"><%= p.created_at ? new Date(p.created_at).toLocaleString('en-GB') : '-' %></td>
                            </tr>
                        <% }) %>
                    <% } else { %>
                        <tr>
                            <td colspan="12" style="text-align: center; padding: 20px;">No registered users yet.</td>
                        </tr>
                    <% } %>
                </tbody>
            </table>
            </div>
        </main>
    </div>
</body>
</html>
