<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Admin - OTP Logs</title>
    <link rel="stylesheet" href="/css/admin-style.css">
    <style>
        .badge { padding: 4px 8px; border-radius: 4px; font-size: 12px; }
        .badge-verified { background: #d4edda; color: #155724; }
        .badge-expired { background: #f8d7da; color: #721c24; }
        .badge-pending { background: #fff3cd; color: #856404; }
    </style>
</head>
<body>
    <div class="admin-layout" style="display: flex;">
        <%- include('partials/sidebar') %>

        <main class="main-content" style="flex: 1; padding: 20px;">
            <h2>OTP Codes Management</h2>
            <p>Monitor all OTP codes requested by users via your Flutter app.</p>

            <table class="table" style="width: 100%; border-collapse: collapse; margin-top: 20px; background: #fff;">
                <thead>
                    <tr style="background: #f4f4f4; text-align: left;">
                        <th style="padding: 12px; border: 1px solid #ddd;">ID</th>
                        <th style="padding: 12px; border: 1px solid #ddd;">Email</th>
                        <th style="padding: 12px; border: 1px solid #ddd;">OTP Code</th>
                        <th style="padding: 12px; border: 1px solid #ddd;">Status</th>
                        <th style="padding: 12px; border: 1px solid #ddd;">Created At</th>
                        <th style="padding: 12px; border: 1px solid #ddd;">Verified At</th>
                    </tr>
                </thead>
                <tbody>
                    <% if (typeof otpLogs !== 'undefined' && otpLogs && otpLogs.length > 0) { %>
                        <% otpLogs.forEach(log => { %>
                            <%
                                const statusLower = (log.status || '').toLowerCase();
                                const badgeClass = statusLower === 'verified' ? 'badge-verified'
                                                 : (statusLower === 'expired' ? 'badge-expired' : 'badge-pending');
                            %>
                            <tr>
                                <td style="padding: 10px; border: 1px solid #ddd;"><%= log.id %></td>
                                <td style="padding: 10px; border: 1px solid #ddd;"><%= log.email %></td>
                                <td style="padding: 10px; border: 1px solid #ddd;"><strong style="color: #007bff;"><%= log.otp_code %></strong></td>
                                <td style="padding: 10px; border: 1px solid #ddd;">
                                    <span class="badge <%= badgeClass %>"><%= log.status %></span>
                                </td>
                                <td style="padding: 10px; border: 1px solid #ddd;"><%= log.created_at %></td>
                                <td style="padding: 10px; border: 1px solid #ddd;"><%= log.verified_at || '-' %></td>
                            </tr>
                        <% }) %>
                    <% } else { %>
                        <tr>
                            <td colspan="6" style="text-align: center; padding: 20px;">No OTP logs found.</td>
                        </tr>
                    <% } %>
                </tbody>
            </table>
        </main>
    </div>
</body>
</html>
