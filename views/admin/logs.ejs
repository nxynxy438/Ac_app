<%- include('partials/header') %>
<%- include('partials/sidebar') %>

<div class="main-content">
  <h1><%= pageTitle %></h1>
  <div class="card">
    <div class="table-responsive">
      <table>
        <thead>
          <tr>
            <th>Log ID</th>
            <th>Action</th>
            <th>Admin</th>
            <th>Target Account</th>
            <th>Timestamp</th>
          </tr>
        </thead>
        <tbody>
          <% logs.forEach(log => { %>
            <tr>
              <td>#<%= log.log_id || log.id %></td>
              <td><%= log.action %></td>
              <td><%= log.admin_name || log.admin || 'System Admin' %></td>
              <td><%= log.targetAccount || log.target || 'N/A' %></td>
              <td><%= log.created_at ? new Date(log.created_at).toLocaleString() : (log.timestamp || 'Just now') %></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </div>
</div>

<%- include('partials/footer') %>