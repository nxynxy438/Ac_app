<%- include('partials/header') %>
<%- include('partials/sidebar') %>

<div class="main-content">
  <h1><%= pageTitle %></h1>
  <div style="display: grid; grid-template-columns: repeat(4, 1fr); gap: 15px; margin-top: 20px;">
    <div class="card">
      <h3>Total Users</h3>
      <p style="font-size: 24px; font-weight: bold; color: #0056b3;"><%= stats.totalUsers %></p>
    </div>
    <div class="card">
      <h3>Active Accounts</h3>
      <p style="font-size: 24px; font-weight: bold; color: #28a745;"><%= stats.activeUsers %></p>
    </div>
    <div class="card">
      <h3>Frozen Accounts</h3>
      <p style="font-size: 24px; font-weight: bold; color: #dc3545;"><%= stats.frozenUsers %></p>
    </div>
    <div class="card">
      <h3>Total Volume</h3>
      <p style="font-size: 24px; font-weight: bold; color: #6f42c1;"><%= stats.totalVolume %></p>
    </div>
  </div>
</div>

<%- include('partials/footer') %>