<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title><%= pageTitle %></title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>

  <%- include('partials/header') %>

  <div class="admin-layout">
    <%- include('partials/sidebar') %>

    <main class="main-content">
      <h1 class="page-header">Customer Account Management</h1>

      <div class="table-container">
        <table>
          <thead>
            <tr>
              <th>ID</th>
              <th>Customer Name</th>
              <th>Email</th>
              <th>Account No.</th>
              <th>Balance</th>
              <th>Status</th>
              <th>Action</th>
            </tr>
          </thead>
          <tbody>
            <% users.forEach(user => { %>
              <tr>
                <td><%= user.id %></td>
                <td><strong><%= user.name %></strong></td>
                <td><%= user.email %></td>
                <td><%= user.accountNo %></td>
                <td>$<%= user.balance.toFixed(2) %></td>
                <td>
                  <span class="badge <%= user.status === 'Active' ? 'badge-active' : 'badge-frozen' %>">
                    <%= user.status %>
                  </span>
                </td>
                <td>
                  <% if (user.status === 'Active') { %>
                    <button class="btn btn-freeze">Freeze Account</button>
                  <% } else { %>
                    <button class="btn btn-activate">Activate</button>
                  <% } %>
                </td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
    </main>
  </div>

  <%- include('partials/footer') %>

</body>
</html>